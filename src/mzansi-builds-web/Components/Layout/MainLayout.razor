@inherits LayoutComponentBase

<div class="page">
    @* We place the NavMenu here so it sits at the very top *@
    <NavMenu />

    <main>
        @* This provides the padding for your page content below the navbar *@
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>