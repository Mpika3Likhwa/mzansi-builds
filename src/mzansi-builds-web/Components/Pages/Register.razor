@page "/register"
@rendermode InteractiveServer

@using mzansi_builds_api.DTOs.User
@inject mzansi_builds_web.Services.AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<section class="container mt-5">
    <div class="row justify-content-center pt-5">
        <div class="col-md-5 form-dark-card p-5">
            <h2 class="text-center mb-4 font-weight-bold" style="color: var(--mz-white);">Join Mzansi Builds</h2>

            <EditForm Model="@registrationModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-muted small">Username</label>
                    <InputText class="form-control form-control-dark"
                               @bind-Value="registrationModel.Username"
                               placeholder="Enter your username"
                               disabled="@isWorking" />
                    <ValidationMessage For="@(() => registrationModel.Username)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Email Address</label>
                    <InputText type="email"
                               class="form-control form-control-dark"
                               @bind-Value="registrationModel.Email"
                               placeholder="email@example.com"
                               disabled="@isWorking" />
                    <ValidationMessage For="@(() => registrationModel.Email)" class="text-danger" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">Password</label>
                    <InputText type="password"
                               class="form-control form-control-dark"
                               @bind-Value="registrationModel.Password"
                               placeholder="Create a strong password"
                               disabled="@isWorking" />
                    <ValidationMessage For="@(() => registrationModel.Password)" class="text-danger" />
                </div>

                @if (!string.IsNullOrEmpty(notificationMessage))
                {
                    <div class="mt-3 alert @(isError ? "alert-danger bg-danger text-white border-0" : "alert-success bg-success text-white border-0") shadow-sm">
                        @notificationMessage
                    </div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-mzansi-green w-100 py-2 fw-bold" disabled="@isWorking">
                        @if (isWorking)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Register</span>
                        }
                    </button>
                </div>
            </EditForm>

            <div class="mt-4 text-center">
                <small class="text-muted">Already have an account? <a href="/login" class="mzansi-link fw-bold">Login here</a></small>
            </div>
        </div>
    </div>
</section>

@code {
    private UserRegistrationDto registrationModel = new();
    private bool isWorking;
    private bool isError;
    private string? notificationMessage;

    private async Task HandleValidSubmit()
    {
        isWorking = true;
        isError = false;
        notificationMessage = null;

        try
        {
            var success = await AuthService.RegisterAsync(registrationModel);
            if (success)
            {
                notificationMessage = AuthService.LastMessage ?? "Registration successful. Redirecting to login...";
                await Task.Delay(600);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                isError = true;
                notificationMessage = AuthService.LastMessage ?? "Registration failed. Please check your details.";
            }
        }
        finally
        {
            isWorking = false;
        }
    }
}

<style>
    /* Main card style consistent with login */
    .form-dark-card {
        background-color: #121212;
        border: 1px solid #333;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }

    /* Force the inputs to be black with white text */
    .form-control-dark {
        background-color: #0d0d0d !important;
        border: 1px solid #444 !important;
        color: white !important;
        caret-color: var(--mzansi-green);
    }

        /* Prevent browser autofill from turning inputs white/yellow */
        .form-control-dark:-webkit-autofill {
            -webkit-text-fill-color: white !important;
            -webkit-box-shadow: 0 0 0px 1000px #0d0d0d inset !important;
        }

        .form-control-dark:focus {
            background-color: #0d0d0d !important;
            color: white !important;
            border-color: var(--mzansi-green) !important;
            box-shadow: 0 0 0 0.25rem rgba(46, 204, 113, 0.2) !important;
            outline: none;
        }

    /* Force the brand green on the link */
    .mzansi-link {
        color: #2ecc71 !important;
        text-decoration: none;
        transition: 0.2s;
    }

        .mzansi-link:hover {
            color: #27ae60 !important;
            text-decoration: underline;
        }
</style>